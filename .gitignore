/bin/
/dist/
/dev/
*.db
*.db-wal
*.db-shm
*.test
*.out
coverage.out
/.build/
coverage.html
.vscode/

# Build artefacts live in /bin/ and /release/ (otfabric/engineering REPO-005)
/release/

# Output of a bare `go build`, anchored so it can never hide a source folder
/cmd/lan-tracker/lan-tracker
/data/oui/gen/gen
/test/fixtures/gen/gen
/test/net/inject/inject
/tools/capcheck/capcheck

# The web UI: dependencies and the build, which make frontend writes and the
# binary embeds (frontend/embed.go); .gitkeep keeps the embed valid without it.
/frontend/node_modules/
/frontend/dist/*
!/frontend/dist/.gitkeep
